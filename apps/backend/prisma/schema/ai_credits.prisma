model AiCreditWallet {
  id                 String                @id @default(cuid())
  companyId          String                @unique
  balance            Int                   @default(200)
  includedBalance    Int                   @default(0)
  totalPurchased     Int                   @default(0)
  totalUsed          Int                   @default(0)
  monthlyAllowance   Int                   @default(0)
  dailyCreditLimit   Int?
  pricingMode        String                @default("DEFAULT") // DEFAULT | UNLIMITED | BYOK_ONLY
  autoTopupEnabled   Boolean               @default(false)
  autoTopupPackageId String?
  lastResetAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  transactions       AiCreditTransaction[]

  @@map("ai_credit_wallets")
}

model AiCreditTransaction {
  id           String         @id @default(cuid())
  walletId     String
  companyId    String
  type         String         // TOPUP_WALLET | TOPUP_KASHIER | TOPUP_RECEIPT | AUTO_TOPUP | ADMIN_GRANT | ADMIN_DEDUCT | USAGE_CHAT | USAGE_AGENT | USAGE_IMAGE | USAGE_VOICE | TRIAL_BONUS | PENDING_TOPUP
  status       String         @default("COMPLETED") // COMPLETED | PENDING | FAILED
  source       String         @default("SYSTEM") // CHAT | AGENT_RUN | IMAGE | VOICE | BILLING | ADMIN | SYSTEM
  creditsDelta Int
  balanceAfter Int
  modelName    String?
  provider     String?
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  agentSteps   Int            @default(0)
  costUsd      Float          @default(0)
  costEgp      Float          @default(0)
  amountEgp    Float          @default(0)
  billingMode  String         @default("PLATFORM") // PLATFORM | BYOK | UNLIMITED | SHADOW
  referenceId  String?
  description  String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  wallet       AiCreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([walletId, createdAt])
  @@index([referenceId])
  @@index([companyId, status, type])
  @@map("ai_credit_transactions")
}
