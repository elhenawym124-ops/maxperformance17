/// Education module - Subjects (e.g. Arabic, Quran, Math)
model EducationSubject {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  price       Float?   @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  packages        EducationPackage[]
  teacherSubjects EducationTeacherSubject[]
  sessions        EducationSession[]

  @@index([companyId])
  @@map("education_subjects")
}

/// Education module - Session packages (hours bundle with suggested session duration)
model EducationPackage {
  id              String   @id @default(cuid())
  companyId       String
  subjectId       String
  name            String
  description     String?
  hoursCount      Float
  sessionDuration Int?     /// Suggested minutes per session
  price           Float
  levelNumber     Int?     /// ترتيب المستوى داخل المسار (1..15) — يسمح بمعرفة الليفل التالي
  durationMonths  Int?     /// مدة الليفل بالشهور (مثال: 3) — تُستخدم كعدد أقساط افتراضي
  ageFrom         Int?     /// أقل سن مناسب للمستوى
  ageTo           Int?     /// أكبر سن مناسب للمستوى
  packageType     String?  @default("GROUP") /// GROUP, PRIVATE
  scheduleSlots   Json?    @default("[]")
  timetable       Json?    @default("[]")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject         EducationSubject @relation(fields: [subjectId], references: [id])

  enrollments EducationEnrollment[]

  @@index([companyId])
  @@index([subjectId])
  @@map("education_packages")
}

/// Education module - Students (children of Parent/Customer)
model EducationStudent {
  id         String     @id @default(cuid())
  companyId  String
  code       String?    /// Student code / كود الطالب
  customerId String     /// Parent (Customer/CRM)
  firstName  String
  lastName   String
  phone      String?
  phone2     String?
  address    String?    /// Residential / home address
  gender     Gender?
  grade      String?    /// Educational level (e.g. "Grade 5", "Beginner")
  subjects   Json?      @default("[]")
  currentLevel Int?     /// المستوى الحالي في المسار (1..15) — يتحدث عند إتمام المستوى
  age        Int?
  branchId   String?
  username   String?
  plainPassword String?
  notes      String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  enrollments EducationEnrollment[]
  sessions    EducationSession[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([customerId])
  @@map("education_students")
}

/// Education module - Teachers
model EducationTeacher {
  id            String   @id @default(cuid())
  companyId     String
  employeeId    String?  /// Optional link to HR Employee
  name          String
  phone         String?
  email         String?
  password      String?  /// Hashed password for teacher portal login
  bio           String?  /// Teacher biography/description
  qualifications String? /// Qualifications, certifications
  avatarUrl     String?  /// Profile picture URL
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  subjectRates EducationTeacherSubject[]
  enrollments  EducationEnrollment[]
  sessions     EducationSession[]
  availability EducationTeacherAvailability[]
  payments     EducationTeacherPayment[]

  @@index([companyId])
  @@map("education_teachers")
}

/// Education module - Teacher availability (working days/hours)
model EducationTeacherAvailability {
  id          String   @id @default(cuid())
  companyId   String
  teacherId   String
  dayOfWeek   Int      /// 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String   /// HH:mm format
  endTime     String   /// HH:mm format
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teacher     EducationTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([teacherId])
  @@map("education_teacher_availability")
}

/// Education module - Teacher payment/salary records
model EducationTeacherPayment {
  id           String   @id @default(cuid())
  companyId    String
  teacherId    String
  periodFrom   DateTime /// Start of payment period
  periodTo     DateTime /// End of payment period
  totalSessions Int     /// Number of sessions in period
  totalHours   Float    /// Total hours worked
  hourlyRate   Float    /// Average hourly rate
  grossAmount  Float    /// Total amount before deductions
  deductions   Float    @default(0)
  netAmount    Float    /// Final amount after deductions
  status       String   @default("PENDING") /// PENDING, PAID, CANCELLED
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teacher      EducationTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([teacherId])
  @@index([status])
  @@map("education_teacher_payments")
}

/// Education module - Teacher subject assignment with hourly rate
model EducationTeacherSubject {
  id         String @id @default(cuid())
  teacherId  String
  subjectId  String
  hourlyRate Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher EducationTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject EducationSubject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("education_teacher_subjects")
}

/// Education module - Package enrollment (student buys a package, teacher is assigned)
model EducationEnrollment {
  id              String        @id @default(cuid())
  companyId       String
  studentId       String
  packageId       String
  teacherId       String?       /// Assigned teacher (admin assigns, not AI)
  remainingHours  Float         /// Hours remaining (deducted on session confirmation)
  totalHours      Float         /// Total hours from package
  amountPaid      Float
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?       @default("CASH")
  installmentCount Int?         @default(1)
  installments    Json?         @default("[]")
  discountType    String?       @default("NONE")
  discountAmount  Float?        @default(0)
  finalAmount     Float?
  branchId        String?
  notes           String?       /// ملاحظات إدارية على الاشتراك (لا تُظهر لولي الأمر)
  enrollmentDate  DateTime      @default(now())
  expiresAt       DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student         EducationStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package         EducationPackage  @relation(fields: [packageId], references: [id])
  teacher         EducationTeacher? @relation(fields: [teacherId], references: [id])

  sessions EducationSession[]

  @@index([companyId])
  @@index([studentId])
  @@index([teacherId])
  @@index([paymentStatus])
  @@map("education_enrollments")
}

/// Education module - Student payment ledger (student & group collections, reversals)
/// Scalar-only model by design: payments must survive enrollment/member deletion for auditing.
model EducationPayment {
  id             String    @id @default(cuid())
  companyId      String
  paymentNumber  String    /// EDU-PAY-YYYYMM-0001
  studentId      String?
  enrollmentId   String?
  groupId        String?
  groupMemberId  String?
  branchId       String?
  packageId      String?
  studentName    String?
  amount         Float
  method         String    @default("CASH") /// CASH, TRANSFER, WALLET, CARD, INSTAPAY, OTHER
  status         String    @default("COMPLETED") /// COMPLETED, PARTIALLY_REVERSED, REVERSED
  source         String    @default("ADMIN") /// ADMIN, PARENT_WALLET, GROUP, INSTALLMENT, SYSTEM, BACKFILL
  receiptNumber  String?
  receiptPdfPath String?
  receiptPdfGeneratedAt DateTime?
  reference      String?
  notes          String?
  paidAt         DateTime  @default(now())
  cashierId      String?
  cashierName    String?
  reversedAmount Float     @default(0)
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, paymentNumber])
  @@index([companyId, paidAt])
  @@index([companyId, studentId])
  @@index([companyId, enrollmentId])
  @@index([companyId, groupMemberId])
  @@index([companyId, branchId])
  @@index([companyId, packageId])
  @@index([companyId, status])
  @@map("education_payments")
}

/// Education module - Online payment intents (Kashier sessions awaiting verification)
model EducationPaymentIntent {
  id                String    @id @default(cuid())
  companyId         String
  customerId        String?
  enrollmentId      String?
  installmentNumber Int?
  amount            Float
  purpose           String    @default("INSTALLMENT") /// INSTALLMENT
  referenceId       String    @unique /// gateway order id
  sessionId         String?
  status            String    @default("PENDING") /// PENDING | COMPLETED | CANCELLED
  paymentId         String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("education_payment_intents")
}

/// Education module - Exams / assessments
model EducationExam {
  id          String    @id @default(cuid())
  companyId   String
  groupId     String?
  packageId   String?
  subjectId   String?
  teacherId   String?
  title       String
  type        String    @default("QUIZ") /// QUIZ | EXAM | ASSESSMENT
  maxScore    Float     @default(100)
  weight      Float?
  scheduledAt DateTime?
  status      String    @default("DRAFT") /// DRAFT | PUBLISHED | CLOSED
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, groupId])
  @@index([companyId, teacherId])
  @@map("education_exams")
}

/// Education module - Student results per exam
model EducationExamResult {
  id          String    @id @default(cuid())
  companyId   String
  examId      String
  studentId   String
  enrollmentId String?
  score       Float?
  maxScore    Float     @default(100)
  grade       String?
  notes       String?
  gradedById  String?
  gradedAt    DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([examId, studentId])
  @@index([companyId, studentId])
  @@index([companyId, examId])
  @@map("education_exam_results")
}

/// Education module - Issued certificates
model EducationCertificate {
  id              String    @id @default(cuid())
  companyId       String
  studentId       String
  enrollmentId    String?
  examId          String?
  type            String    @default("ACHIEVEMENT") /// LEVEL | COURSE | ACHIEVEMENT
  title           String
  level           String?
  serialNumber    String
  issuedAt        DateTime  @default(now())
  issuedById      String?
  notes           String?
  pdfPath         String?
  pdfGeneratedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, serialNumber])
  @@index([companyId, studentId])
  @@index([companyId, issuedAt])
  @@map("education_certificates")
}

/// Education module - Weekly group alerts (loss / low occupancy)
model EducationGroupAlert {
  id          String    @id @default(cuid())
  companyId   String
  groupId     String
  groupName   String?
  type        String    /// LOSS | LOW_OCCUPANCY | HIGH_DUES | HIGH_TEACHER_COST
  severity    String    @default("MEDIUM") /// LOW | MEDIUM | HIGH
  message     String
  suggestion  String?
  metrics     Json?
  weekKey     String    /// YYYY-Www so the same group is not re-alerted twice a week
  status      String    @default("OPEN") /// OPEN | RESOLVED | IGNORED
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, groupId, type, weekKey])
  @@index([companyId, status])
  @@map("education_group_alerts")
}

/// Education module - Win-back worklist for at-risk students
model EducationWinbackAction {
  id             String    @id @default(cuid())
  companyId      String
  studentId      String
  studentName    String?
  phone          String?
  status         String    @default("OPEN") /// OPEN | DONE | IGNORED
  priority       Int       @default(0)
  attendanceRate Float?
  dues           Float     @default(0)
  overdue        Float     @default(0)
  reasons        Json?
  handledAt      DateTime?
  handledBy      String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, studentId])
  @@map("education_winback_actions")
}

/// Education module - Coupon codes (discount engine)
model EducationCoupon {
  id              String    @id @default(cuid())
  companyId       String
  code            String
  type            String    @default("PERCENT") /// PERCENT | AMOUNT
  value           Float
  minAmount       Float?
  maxDiscount     Float?
  scope           String    @default("ALL") /// ALL | PACKAGE | GROUP
  packageId       String?
  groupId         String?
  maxUses         Int?
  usedCount       Int       @default(0)
  perStudentLimit Int?
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("education_coupons")
}

/// Education module - Coupon redemptions (audit + per-student limit)
model EducationCouponRedemption {
  id           String   @id @default(cuid())
  companyId    String
  couponId     String
  studentId    String?
  customerId   String?
  enrollmentId String?
  paymentId    String?
  discount     Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([companyId, couponId])
  @@index([couponId, studentId])
  @@map("education_coupon_redemptions")
}

/// Education module - Daily closing snapshot (Z-report lock per day)
model EducationDailyClosing {
  id                 String    @id @default(cuid())
  companyId          String
  date               DateTime  @db.Date
  status             String    @default("CLOSED") /// CLOSED | REOPENED
  snapshot           Json?
  cashTotal          Float     @default(0)
  cardTotal          Float     @default(0)
  transferTotal      Float     @default(0)
  walletTotal        Float     @default(0)
  otherTotal         Float     @default(0)
  totalGross         Float     @default(0)
  totalNet           Float     @default(0)
  reversedTotal      Float     @default(0)
  walletTopupsTotal  Float     @default(0)
  treasuryDeposits   Float     @default(0)
  treasuryExpenses   Float     @default(0)
  treasuryNet        Float     @default(0)
  cashierExpected    Float     @default(0)
  cashierActual      Float     @default(0)
  cashierDifference  Float     @default(0)
  closedById         String?
  closedByName       String?
  closedAt           DateTime  @default(now())
  reopenedAt         DateTime?
  reopenedById       String?
  reopenReason       String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("education_daily_closings")
}

/// Education module - Cashier shifts for daily cash reconciliation
model EducationCashierShift {
  id             String    @id @default(cuid())
  companyId      String
  cashierId      String
  cashierName    String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingBalance Float     @default(0)
  closingBalance Float?
  cashCollected  Float     @default(0)
  cashReversed   Float     @default(0)
  expectedCash   Float     @default(0)
  difference     Float?
  declaredByMethod Json?  /// Per-method counted amounts at close: {"CASH": 1200, "TRANSFER": 300}
  status         String    @default("OPEN") /// OPEN | CLOSED
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status], map: "idx_edu_cashier_shift_status")
  @@index([companyId, openedAt], map: "idx_edu_cashier_shift_opened")
  @@map("education_cashier_shifts")
}

/// Education module - Individual sessions (lessons)
model EducationSession {
  id              String                  @id @default(cuid())
  companyId       String
  enrollmentId    String
  teacherId       String
  studentId       String
  subjectId       String
  scheduledAt     DateTime
  plannedDuration Int                     /// Planned minutes
  actualDuration  Int?                    /// Actual minutes (teacher confirms after session)
  status          EducationSessionStatus  @default(SCHEDULED)
  sessionType     String?                 @default("PRIVATE") /// PRIVATE, GROUP
  makeupForSessionId String?              /// Link to the missed session this one compensates
  topic           String?
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollment      EducationEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher         EducationTeacher        @relation(fields: [teacherId], references: [id])
  student         EducationStudent        @relation(fields: [studentId], references: [id])
  subject         EducationSubject        @relation(fields: [subjectId], references: [id])

  @@index([companyId])
  @@index([enrollmentId])
  @@index([studentId])
  @@index([teacherId])
  @@index([scheduledAt])
  @@index([status])
  @@index([makeupForSessionId])
  @@map("education_sessions")
}

/// مجموعة تعليمية — الجدول كان يُنشأ بـraw SQL وقت التشغيل بدون موديل،
/// فكان prisma db push يعتبره drift ويحاول DROPه (Schema Guard أوقف النشر).
model EducationGroup {
  id               String    @id
  companyId        String
  name             String
  code             String?
  subjectId        String
  teacherId        String?
  level            String?
  capacity         Int       @default(15)
  feeType          String    @default("MONTHLY")
  feeAmount        Float     @default(0)
  teacherRateType  String    @default("PERCENTAGE")
  teacherRateValue Float     @default(50)
  scheduleDays     Json      @default("[]")
  scheduleSlots    Json?     @default("[]")
  startTime        String?   @default("17:00")
  endTime          String?   @default("18:30")
  room             String?
  branchId         String?
  classroomId      String?
  ageFrom          Int?
  ageTo            Int?
  status           String    @default("OPEN")
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId], map: "idx_education_groups_company")
  @@index([subjectId], map: "idx_education_groups_subject")
  @@index([teacherId], map: "idx_education_groups_teacher")
  @@map("education_groups")
}

model EducationGroupMember {
  id              String    @id
  companyId       String
  groupId         String
  studentId       String
  status          String    @default("ACTIVE")
  joinedAt        DateTime  @default(now())
  paymentStatus   String    @default("PAID")
  amountPaid      Float     @default(0)
  discountAmount  Float     @default(0)
  discountReason  String?
  nextRenewalDate DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([groupId], map: "idx_edu_group_members_group")
  @@index([studentId], map: "idx_edu_group_members_student")
  @@index([companyId], map: "idx_edu_group_members_company")
  @@map("education_group_members")
}

model EducationGroupSession {
  id          String   @id
  companyId   String
  groupId     String
  teacherId   String?
  sessionDate DateTime
  topic       String?
  homework    String?
  status      String   @default("COMPLETED")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([groupId], map: "idx_edu_group_sessions_group")
  @@index([companyId], map: "idx_edu_group_sessions_company")
  @@map("education_group_sessions")
}

model EducationGroupAttendance {
  id               String    @id
  companyId        String
  sessionId        String
  groupId          String
  studentId        String
  status           String    @default("PRESENT")
  notes            String?
  notifiedParentAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([sessionId], map: "idx_edu_group_att_session")
  @@index([studentId], map: "idx_edu_group_att_student")
  @@map("education_group_attendance")
}

model EducationDemoDay {
  id              String   @id
  companyId       String
  title           String
  description     String?
  subjectId       String?
  teacherId       String?
  branchId        String?
  classroomId     String?
  googleMapsUrl   String?
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  locationType    String   @default("ONLINE")
  meetingLink     String?
  room            String?
  capacity        Int      @default(20)
  status          String   @default("SCHEDULED")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId], map: "idx_edu_demo_days_company")
  @@index([branchId], map: "idx_edu_demo_days_branch")
  @@index([scheduledAt], map: "idx_edu_demo_days_scheduled")
  @@index([status], map: "idx_edu_demo_days_status")
  @@map("education_demo_days")
}

model EducationDemoAttendee {
  id                 String   @id
  companyId          String
  demoDayId          String
  customerId         String?
  studentName        String
  guardianName       String?
  phone              String
  phone2             String?
  email              String?
  age                Int?
  grade              String?
  branchId           String?
  attendanceStatus   String   @default("REGISTERED")
  conversionStatus   String   @default("PENDING")
  convertedStudentId String?
  /// تتبّع مصدر التسجيل (يُستخدم عبر raw SQL في DemoDay controller)
  registeredByType   String?  @default("EMPLOYEE")
  registeredByUserId String?
  registeredByName   String?
  sourceChannel      String?
  sourceRaw          String?
  campaignName       String?
  adRef              String?
  postRef            String?
  landingUrl         String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId], map: "idx_edu_demo_att_company")
  @@index([demoDayId], map: "idx_edu_demo_att_demoday")
  @@index([customerId], map: "idx_edu_demo_att_customer")
  @@index([phone], map: "idx_edu_demo_att_phone")
  @@index([attendanceStatus], map: "idx_edu_demo_att_status")
  @@map("education_demo_attendees")
}
